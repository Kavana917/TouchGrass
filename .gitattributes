# Normalize line endings: LF in the repository, native in the working copy.
# Without this, committing from Windows records CRLF and every file looks
# rewritten when touched from another machine or from CI.
* text=auto eol=lf

# Must stay CRLF — Windows batch files break with LF.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Must stay LF — shell scripts break with CRLF.
gradlew text eol=lf
*.sh    text eol=lf

# Binary: never convert, never diff as text.
*.jar   binary
*.webp  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.keystore binary
*.jks   binary
*.apk   binary
*.aab   binary

# Markdown planning docs — show word-level diffs, they're prose.
*.md    text diff=markdown
