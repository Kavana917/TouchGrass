<?xml version="1.0" encoding="utf-8"?>
<!--
    Android blocks plain HTTP by default, and rightly so.

    Several public webcam networks still serve their HLS manifests over
    HTTP only. Rather than switching cleartext on globally, this permits it
    for exactly the hosts we stream from and nothing else — everything the
    app actually cares about (the digest, the stream registry, anything
    carrying user data) stays HTTPS-only and is unaffected.

    These carry no credentials and no personal data: they are public
    one-way video feeds. The realistic risk of cleartext here is someone on
    the same network seeing which webcam you're watching.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- EarthCam's public webcam network -->
        <domain includeSubdomains="true">earthcam.com</domain>
        <!-- BeachCam (Portugal) -->
        <domain includeSubdomains="true">iol.pt</domain>
    </domain-config>
</network-security-config>
