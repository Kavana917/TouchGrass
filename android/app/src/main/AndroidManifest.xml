<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Usage access. NOT a runtime permission - the user grants it on a
        Settings screen, and we detect the result via AppOpsManager rather
        than the normal permission API. See UsagePermission.kt.

        It reads app names and durations only. It cannot see anything that
        happens inside another app.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Draw over other apps. This is how the wall appears on top of
        Instagram.

        It is NOT optional decoration: since Android 10, an app cannot start
        an Activity from the background. startActivity() from our service
        fails SILENTLY - no crash, no log, nothing happens. Drawing a
        TYPE_APPLICATION_OVERLAY window is the only way to put something on
        screen over another app.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Keeps the usage monitor alive while a watched app is in the foreground. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Required to show the monitor's persistent notification on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Restart the monitor after a reboot so a restart is not a free reset. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Lets us list launchable apps for the watched-app picker WITHOUT
        QUERY_ALL_PACKAGES, which is a sensitive permission Play scrutinises
        heavily. We only need apps that appear in the launcher.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TouchGrassApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.TouchGrass"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TouchGrass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.usage.UsageMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!--
                Android 14+ requires a declared subtype for specialUse.
                Ours is genuinely a screen-time monitor; this string is what
                gets reviewed by Play.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors foreground app usage to enforce the user's own self-imposed daily time budget." />
        </service>

        <!--
            Remove WorkManager's automatic initialiser. The Application
            supplies its own Configuration so the watchdog worker can have
            dependencies injected; leaving this in means WorkManager wins the
            race and the injected worker fails to construct at runtime.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <receiver
            android:name=".core.usage.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
