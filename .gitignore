# ---- Android / Gradle ----
*.iml
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
local.properties
release/
*.apk
*.aab
*.ap_
*.dex
*.class
lint/
# Kotlin compiler daemon session state — transient, regenerated every build
.kotlin/
# Keep the wrapper itself — it must be committed
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# ---- Signing & secrets ----
# Never commit these. Release keys and API tokens stay off the repo.
*.jks
*.keystore
keystore.properties
signing.properties
secrets.properties
.env
.env.*

# ---- Android Studio / IntelliJ ----
# Ignored at any depth (root and android/). Android Studio's own .gitignore
# keeps some .idea files tracked by default; for a solo repo that's just churn.
.idea/
.navigation/
*.hprof

# ---- Python (the backend aggregator job) ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Backend output artifacts ----
# streams.json / digest.json are generated by the cron job, not authored by hand.
# If a hand-curated seed version is added later, force-add it: git add -f <path>
backend/out/
*.log

# ---- OS noise ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---- Editors ----
*.swp
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
